---
import claudeIcon from '../assets/icons/claude-color.svg?raw';
import openaiIcon from '../assets/icons/openai.svg?raw';
import slopbotIcon from '../assets/icons/slopbot.svg?raw';
import { markdownPath } from '../lib/pages';

const { entry, sidebar } = Astro.locals.starlightRoute;
type SidebarEntry = (typeof sidebar)[number];
// Starlight links the table of contents to this ID.
const PAGE_TITLE_ID = '_top';
const topic = Astro.locals.starlightSidebarTopics?.topics.find((t) => t.isCurrent);

// The label of the sidebar group that holds the current page.
function currentGroup(entries: SidebarEntry[]): string | undefined {
  for (const item of entries) {
    if (item.type !== 'group') continue;
    if (item.entries.some((child) => child.type === 'link' && child.isCurrent)) return item.label;
    const nested = currentGroup(item.entries);
    if (nested) return nested;
  }
}

const crumbs = [topic?.label, currentGroup(sidebar)].filter(
  (label, index, all): label is string => Boolean(label) && all.indexOf(label) === index,
);
const path = markdownPath(entry.id);
const pageUrl = new URL(path, Astro.site).href;
const prompt = `Read ${pageUrl} so I can ask questions about it.`;

// Slopbot is PMServers' own AI agent. It is not ready yet: with no URL, the item shows "Coming soon".
const SLOPBOT_URL = '';

const markdownIcon = `<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><rect x="2.5" y="5.5" width="19" height="13" rx="2"/><path d="M6 15V9l2.5 3L11 9v6M15.5 9v6m0 0-2-2.2m2 2.2 2-2.2"/></svg>`;
const menu = [
  { href: path, icon: markdownIcon, label: 'View as Markdown', detail: 'This page as plain text', external: false },
  { href: `https://claude.ai/new?q=${encodeURIComponent(prompt)}`, icon: claudeIcon, label: 'Open in Claude', detail: 'Ask questions about this page', external: true },
  { href: `https://chatgpt.com/?q=${encodeURIComponent(prompt)}`, icon: openaiIcon, label: 'Open in ChatGPT', detail: 'Ask questions about this page', external: true },
  SLOPBOT_URL
    ? { href: `${SLOPBOT_URL}?q=${encodeURIComponent(prompt)}`, icon: slopbotIcon, label: 'Open in Slopbot', detail: 'Ask PMS Cloud\'s own agent', external: true }
    : { href: undefined, icon: slopbotIcon, label: 'Open in Slopbot', detail: 'Coming soon', external: false },
];
---

{
  crumbs.length > 0 && (
    <nav class="crumbs" aria-label="Breadcrumb">
      {crumbs.map((label, index) => (
        <>
          {index > 0 && <span aria-hidden="true">›</span>}
          <span>{label}</span>
        </>
      ))}
    </nav>
  )
}

<div class="title-row">
  <h1 id={PAGE_TITLE_ID}>{entry.data.title}</h1>
  <div class="copy-page">
    <button type="button" class="copy-main" data-copy-markdown={path}>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <rect x="5" y="5" width="8.5" height="8.5" rx="1.5" fill="none" stroke="currentColor" stroke-width="1.3"></rect>
        <path d="M10.5 3.5v-.5A1.5 1.5 0 0 0 9 1.5H3A1.5 1.5 0 0 0 1.5 3v6A1.5 1.5 0 0 0 3 10.5h.5" fill="none" stroke="currentColor" stroke-width="1.3"></path>
      </svg>
      <span data-label>Copy page</span>
    </button>
    <details class="copy-menu">
      <summary aria-label="More page options">
        <svg viewBox="0 0 16 16" width="12" height="12" aria-hidden="true">
          <path d="m4 6 4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.5"></path>
        </svg>
      </summary>
      <div class="menu">
        {
          menu.map((item) => (
            <a
              href={item.href}
              aria-disabled={item.href ? undefined : 'true'}
              {...(item.external ? { target: '_blank', rel: 'noopener' } : {})}
            >
              <span class="menu-icon" set:html={item.icon} />
              <span class="menu-text">
                <span class="menu-label">
                  {item.label}
                  {item.external && <span aria-hidden="true"> ↗</span>}
                </span>
                <span class="menu-detail">{item.detail}</span>
              </span>
            </a>
          ))
        }
      </div>
    </details>
  </div>
</div>

{entry.data.description && <p class="lead">{entry.data.description}</p>}

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy-markdown]')) {
    button.addEventListener('click', async () => {
      const response = await fetch(button.dataset.copyMarkdown!);
      await navigator.clipboard.writeText(await response.text());
      const label = button.querySelector('[data-label]')!;
      label.textContent = 'Copied';
      setTimeout(() => (label.textContent = 'Copy page'), 1500);
    });
  }
  // Close the menu on a click outside it.
  document.addEventListener('click', (event) => {
    for (const menu of document.querySelectorAll<HTMLDetailsElement>('.copy-menu[open]')) {
      if (!menu.contains(event.target as Node)) menu.open = false;
    }
  });
</script>

<style>
  .crumbs {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  .title-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.5rem;
  }
  h1 {
    margin: 0;
    font-family: var(--pms-font-serif);
    font-size: clamp(1.875rem, 1.5rem + 1.2vw, 2.375rem);
    font-weight: 500;
    line-height: 1.2;
    letter-spacing: -0.01em;
    color: var(--sl-color-white);
  }
  .lead {
    margin-top: 0.75rem;
    color: var(--sl-color-gray-2);
    font-size: 1.125rem;
    line-height: 1.55;
  }
  .copy-page {
    position: relative;
    display: flex;
    flex-shrink: 0;
    margin-top: 0.375rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--pms-surface);
    font-size: var(--sl-text-sm);
  }
  .copy-main,
  summary {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.3rem 0.7rem;
    border: 0;
    background: transparent;
    color: var(--sl-color-gray-1);
    font: inherit;
    cursor: pointer;
  }
  summary {
    padding: 0.3rem 0.5rem;
    border-inline-start: 1px solid var(--sl-color-gray-5);
    list-style: none;
    height: 100%;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .copy-main:hover,
  summary:hover {
    color: var(--sl-color-white);
  }
  .menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.375rem);
    z-index: 10;
    display: flex;
    flex-direction: column;
    min-width: 17.5rem;
    padding: 0.25rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--pms-surface);
    box-shadow: 0 8px 24px rgb(0 0 0 / 0.2);
  }
  .menu a {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.5rem 0.6rem;
    border-radius: 0.375rem;
    color: var(--sl-color-gray-1);
    text-decoration: none;
  }
  .menu a:hover {
    background: var(--pms-pill);
    color: var(--sl-color-white);
  }
  .menu a[aria-disabled='true'] {
    cursor: default;
    opacity: 0.55;
  }
  .menu a[aria-disabled='true']:hover {
    background: transparent;
  }
  .menu-icon {
    display: grid;
    place-items: center;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.375rem;
    color: var(--sl-color-white);
  }
  .menu-icon :global(svg) {
    width: 1.05rem;
    height: 1.05rem;
  }
  .menu-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .menu-label {
    color: var(--sl-color-white);
  }
  .menu-detail {
    color: var(--sl-color-gray-3);
    font-size: 0.75rem;
  }
  @media (max-width: 40rem) {
    .title-row {
      flex-direction: column;
    }
  }
</style>
