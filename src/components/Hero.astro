---
import { Code } from '@astrojs/starlight/components';

const python = `from openai import OpenAI

client = OpenAI(
    base_url="https://api.pmservers.org/ai/v1",
    api_key="pms_sk_...",
)

answer = client.chat.completions.create(
    model="cirrus",
    messages=[{"role": "user", "content": "Hello"}],
)
print(answer.choices[0].message.content)`;

const javascript = `import OpenAI from 'openai';

const client = new OpenAI({
  baseURL: 'https://api.pmservers.org/ai/v1',
  apiKey: process.env.PMS_API_KEY,
});

const answer = await client.chat.completions.create({
  model: 'cirrus',
  messages: [{ role: 'user', content: 'Hello' }],
});
console.log(answer.choices[0].message.content);`;

const curl = `curl https://api.pmservers.org/ai/v1/chat/completions \\
  -H "Authorization: Bearer $PMS_API_KEY" \\
  -H "Content-Type: application/json" \\
  -d '{
    "model": "cirrus",
    "messages": [{"role": "user", "content": "Hello"}]
  }'`;

const products = [
  {
    title: 'Containers',
    text: 'Always-on workers from any image. Private ports to other containers in the project.',
    link: '/containers/overview/',
    icon: 'M4 8l8-4 8 4-8 4zM4 8v8l8 4 8-4V8M12 12v8',
  },
  {
    title: 'Databases',
    text: 'Postgres, with optional pgvector. Private to the containers in your account.',
    link: '/databases/overview/',
    icon: 'M5 6c0-1.1 3.1-2 7-2s7 .9 7 2-3.1 2-7 2-7-.9-7-2zM5 6v12c0 1.1 3.1 2 7 2s7-.9 7-2V6M5 12c0 1.1 3.1 2 7 2s7-.9 7-2',
  },
  {
    title: 'AI API',
    text: 'OpenAI-compatible chat, embeddings and decisions. Billed by token.',
    link: '/get-started/first-ai-request/',
    icon: 'M8 9l-3 3 3 3M16 9l3 3-3 3M13.5 7l-3 10',
  },
];

// Small line icons for the buttons, 16 by 16.
const icons = {
  play: '<path d="M5 3.5v9l7-4.5z"/>',
  key: '<circle cx="5.5" cy="10.5" r="2.5"/><path d="m7.3 8.7 5.2-5.2M10.5 5.5l1.5 1.5M9 7l1.2 1.2"/>',
  braces:
    '<path d="M6 2.5c-1.5 0-2 .7-2 2V6c0 1-.5 2-1.5 2 1 0 1.5 1 1.5 2v1.5c0 1.3.5 2 2 2M10 2.5c1.5 0 2 .7 2 2V6c0 1 .5 2 1.5 2-1 0-1.5 1-1.5 2v1.5c0 1.3-.5 2-2 2"/>',
};
const icon = (name: keyof typeof icons) =>
  `<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">${icons[name]}</svg>`;
---

<section class="hero">
  <div class="intro">
    <p class="eyebrow">PMS Cloud</p>
    <h1 id="_top">Build on<br />PMS Cloud</h1>
    <p class="tagline">
      Containers, databases and an OpenAI-compatible AI API. Docs for people, and for the agents that work with them.
    </p>
    <button type="button" class="search" data-open-search>
      <svg viewBox="0 0 16 16" width="14" height="14" aria-hidden="true">
        <circle cx="7" cy="7" r="4.5" fill="none" stroke="currentColor" stroke-width="1.4"></circle>
        <path d="m10.5 10.5 3 3" stroke="currentColor" stroke-width="1.4"></path>
      </svg>
      <span>Search</span>
      <kbd data-search-key>Ctrl K</kbd>
    </button>
    <div class="actions">
      <a href="/get-started/overview/"><Fragment set:html={icon('play')} />Quickstart</a>
      <a href="/ai/keys/"><Fragment set:html={icon('key')} />Get an API key</a>
      <a href="/api/overview/"><Fragment set:html={icon('braces')} />API reference</a>
    </div>
  </div>
  <div class="code-panel" data-code-tabs>
    <Code code={python} lang="python" />
    <Code code={javascript} lang="js" />
    <Code code={curl} lang="sh" />
  </div>
</section>

<section class="products">
  <p class="eyebrow">Products</p>
  <h2>Choose what you build</h2>
  <p class="section-text">Pick a product. Each one has a quickstart. S3 storage comes next.</p>
  <div class="cards">
    {
      products.map((product) => (
        <a class="card" href={product.link}>
          <div class="card-art">
            <svg viewBox="0 0 24 24" width="56" height="56" aria-hidden="true">
              <path d={product.icon} fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <div class="card-body">
            <h3>{product.title}</h3>
            <p>{product.text}</p>
            <span class="card-link"><Fragment set:html={icon('play')} />Quickstart</span>
          </div>
        </a>
      ))
    }
  </div>
</section>

<script>
  import '../scripts/code-tabs';

  // Starlight opens search with Ctrl K, or Cmd K on a Mac.
  if (/Mac|iPhone|iPad/.test(navigator.platform)) {
    const key = document.querySelector('[data-search-key]');
    if (key) key.textContent = '⌘K';
  }

  document.querySelector('[data-open-search]')?.addEventListener('click', (event) => {
    // Stop this click here. Starlight closes the search dialog on a click outside it.
    event.stopPropagation();
    document.querySelector<HTMLButtonElement>('site-search button[data-open-modal]')?.click();
  });
</script>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 3rem;
    align-items: center;
    padding-block: 2rem 4rem;
  }
  .eyebrow {
    margin: 0;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
  }
  h1 {
    margin: 1rem 0 0;
    font-family: var(--pms-font-serif);
    font-size: clamp(2.75rem, 2rem + 3vw, 4rem);
    font-weight: 500;
    line-height: 1.05;
    letter-spacing: -0.02em;
    color: var(--sl-color-white);
  }
  .tagline {
    max-width: 30rem;
    margin-top: 1.5rem;
    color: var(--sl-color-gray-2);
    font-size: 1.0625rem;
    line-height: 1.55;
  }
  .search {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    max-width: 18rem;
    margin-top: 1.75rem;
    padding: 0.45rem 0.75rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--pms-surface);
    color: var(--sl-color-gray-3);
    font: inherit;
    font-size: var(--sl-text-sm);
    cursor: pointer;
  }
  .search span {
    flex: 1;
    text-align: start;
  }
  .search kbd {
    padding: 0 0.35rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.25rem;
    font-family: var(--sl-font-mono);
    font-size: 0.75rem;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    margin-top: 1.25rem;
  }
  .actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 0.8rem;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.5rem;
    background: var(--pms-pill);
    color: var(--sl-color-gray-1);
    font-size: var(--sl-text-sm);
    text-decoration: none;
  }
  .actions a:hover {
    color: var(--sl-color-white);
    border-color: var(--sl-color-gray-4);
  }
  .code-panel {
    min-width: 0;
  }
  .products {
    padding-bottom: 3rem;
  }
  .products h2 {
    margin: 0.5rem 0 0;
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }
  .section-text {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-2);
  }
  .cards {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.25rem;
    margin-top: 2rem;
  }
  .card {
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--sl-color-gray-5);
    border-radius: 0.75rem;
    color: inherit;
    text-decoration: none;
  }
  .card:hover {
    border-color: var(--sl-color-gray-4);
  }
  .card-art {
    display: grid;
    place-items: center;
    height: 9rem;
    border-bottom: 1px solid var(--sl-color-gray-5);
    background: var(--pms-surface);
    color: var(--sl-color-gray-2);
  }
  .card-body {
    padding: 1.25rem;
  }
  .card h3 {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin: 0;
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--sl-color-white);
  }
  .card p {
    margin-top: 0.5rem;
    color: var(--sl-color-gray-3);
    font-size: var(--sl-text-sm);
    line-height: 1.5;
  }
  .card-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: 1rem;
    color: var(--sl-color-gray-2);
    font-size: var(--sl-text-sm);
  }
  .card:hover .card-link {
    color: var(--sl-color-white);
  }

  @media (min-width: 50rem) {
    .cards {
      grid-template-columns: repeat(2, 1fr);
    }
  }
  @media (min-width: 72rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
      gap: 4rem;
      padding-block: 4rem 6rem;
    }
    .cards {
      grid-template-columns: repeat(3, 1fr);
    }
  }
</style>
